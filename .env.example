# Copy to .env.local for local development. Do not place secrets in VITE_* values.
YOMART_BUILD_ENV=local
VITE_API_BASE_URL=http://localhost:3000
YOMART_EXPECTED_API_ORIGIN=http://localhost:3000
VITE_EXPECTED_SITE_ORIGIN=http://localhost:5173
VITE_ALLOW_LOCAL_API=true

# Staging only: if no production API origin has been confirmed, assert that
# explicitly and leave the production API denylist blank. If one is confirmed,
# set the assertion to false/unset and list only confirmed HTTPS origins.
# YOMART_NO_PRODUCTION_API=true
# YOMART_PRODUCTION_API_ORIGINS=
# Production site origins may remain blank/unset in staging until confirmed.
# YOMART_PRODUCTION_SITE_ORIGINS=

# Production builds additionally require the real staging API and site origins:
# YOMART_STAGING_API_ORIGINS=
# YOMART_STAGING_SITE_ORIGINS=
